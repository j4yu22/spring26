    "# Q1\n",
    "# Q: How does your name at your birth year compare to its use historically?\n",
    "\n",
    "my_name = \"Jay\"\n",
    "birth_year = 2002\n",
    "\n",
    "name_history = (\n",
    "    df\n",
    "    .filter(pl.col(\"name\") == my_name)\n",
    "    .select([\"name\", \"year\", \"Total\"])\n",
    "    .sort(\"year\")\n",
    ")\n",
    "\n",
    "birth_year_row = (\n",
    "    name_history\n",
    "    .filter(pl.col(\"year\") == birth_year)\n",
    ")\n",
    "\n",
    "(\n",
    "    ggplot(name_history, aes(x=\"year\", y=\"Total\"))\n",
    "    + geom_line()\n",
    "    + geom_point(data=birth_year_row, size=5)\n",
    "    + labs(\n",
    "        title=f\"Historical Use of the Name {my_name}\",\n",
    "        subtitle=f\"{my_name} in {birth_year} compared to all available years\",\n",
    "        x=\"Year\",\n",
    "        y=\"Number of Babies\"\n",
    "    )\n",
    "    + scale_x_continuous(format=\".0f\")\n",
    ")"
   ]
